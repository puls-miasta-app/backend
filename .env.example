# =========================================================================
# PulsMiasta backend — example environment file.
# Copy to `.env` and fill in the blanks. `.env` itself is git-ignored.
# =========================================================================

# ---------- Database (MySQL) ----------
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=puls_miasta
DATABASE_USERNAME=user
DATABASE_PASSWORD=change_me

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- App ----------
APP_BASE_URL=http://localhost:3000
# Comma-separated list, must be exact origins (no wildcards) because the API
# uses HttpOnly cookies with allowCredentials=true.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5173

# ---------- File encryption (AES-GCM) ----------
# Which AES_KEY_V<n> is the currently active key used for new encryptions.
AES_ACTIVE_KEY=1
# Base64-encoded 32-byte (256-bit) key. Generate with:
#   openssl rand -base64 32
# You can add more versioned keys (AES_KEY_V2, V3, ...) for rotation; old
# keys must stay around so already-encrypted photos can still be decrypted.
AES_KEY_V1=replace_with_base64_encoded_32_byte_key

# ---------- Cloudflare R2 (S3-compatible object storage) ----------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=puls-miasta-photos
R2_REGION=auto
# Upload size limits (bytes). Defaults: 5 MB multipart threshold / part size, 20 MB max.
R2_MULTIPART_THRESHOLD=5242880
R2_MULTIPART_PART_SIZE=5242880
R2_MAX_FILE_SIZE=20971520

# ---------- Mail (SMTP) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

# ---------- Gemini (Google Generative Language API) ----------
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
# If true, a Gemini failure aborts report creation (503). If false (default),
# the report is still saved but without AI-analysed category/priority/description.
GEMINI_FAIL_ON_ERROR=false
# Gate on Gemini's reported confidence. Reports below this get the AI fields left empty
# so an official reviews them by hand; 0 disables the gate.
GEMINI_MIN_CONFIDENCE=0.3

# ---------- WebAuthn / Passkey ----------
# Must match the registrable domain of your frontend origin (no scheme, no port).
# Use "localhost" for local dev; production should be e.g. "pulsmiasta.example.com".
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PulsMiasta
# Comma-separated list of allowed origins. Must include exact origin(s) used by
# the frontend / mobile app.
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:5500
# How long a WebAuthn challenge remains valid (seconds).
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# ---------- Auth — email verification ----------
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24

# ---------- Auth — sudo mode (email OTP) ----------
AUTH_SUDO_OTP_TTL_MINUTES=10
AUTH_SUDO_OTP_COOLDOWN_SECONDS=60
AUTH_SUDO_OTP_MAX_ATTEMPTS=3

# ---------- Auth — TOTP 2FA ----------
AUTH_TOTP_PENDING_TTL_MINUTES=5
AUTH_TOTP_SETUP_TTL_MINUTES=10

# ---------- Auth — login lockout ----------
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_LOCKOUT_MINUTES=30
AUTH_LOGIN_ATTEMPTS_TTL_MINUTES=15

# ---------- Auth — rate limiting ----------
AUTH_RATE_LIMIT_DEFAULT_LIMIT=10
AUTH_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=20
# Comma-separated list of trusted proxy IPs allowed to set X-Forwarded-For /
# X-Real-IP headers. Leave empty if the app is exposed directly (no proxy).
AUTH_RATE_LIMIT_TRUSTED_PROXIES=
